
RPC_URL=https://rpc.ankr.com/bsc,https://bsc-dataseed.binance.org,https://bsc-dataseed1.binance.org


#chrome0 测试3 对应的predict 导出的sy
PRIVY_PRIVATE_KEY=xxx
#导出的地址
#PREDICT_ACCOUNT=xxx
#predict.fun deposit的地址
PREDICT_ACCOUNT=xxxx

PREDICT_API_KEY=xxxx

# FICLASH 本地代理地址；赛中 Dota 脚本的所有 HTTP 请求都走该代理
FICLASH_PROXY_URL=http://127.0.0.1:7890

# 赛中 Dota 脚本轮询间隔
DOTA2_INGAME_INTERVAL_MS=3000
# 每个方向单次挂买数量；默认101，若改为100请同时把下面的撤单阈值改为100
DOTA2_INGAME_ORDER_SHARES=101
# 某方向持仓达到该数量后停止该方向买入
DOTA2_INGAME_POSITION_LIMIT_SHARES=100
# 买单剩余量低于该数量时撤单并通知挂买流程重新判断
DOTA2_INGAME_MIN_BUY_ORDER_SHARES=101
# 两个独立监控子流程的轮询间隔
DOTA2_INGAME_POSITION_INTERVAL_MS=2000
DOTA2_INGAME_BUY_MONITOR_INTERVAL_MS=1000
# 定时只撤买单，撤完唤醒挂买流程；默认11分钟
DOTA2_INGAME_BUY_CANCEL_INTERVAL_MS=660000

# 每分钟查询
MIN_INTERVAL_SECONDS=60
# 无新增时每5分钟推送一次
NORMAL_PUSH_INTERVAL_SECONDS=300
#DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=1111
DING_ACCESS_TOKEN=111
DING_SECRET=1111

# token缓存失效时间
JWT_CACHE_TTL_SECONDS

# 先保持纸面模式
Z_LIVE_TRADING=false

# 首次真实验证时建议 1 USDT
Z_EXECUTION_NOTIONAL_USD=1

# 超过 3 秒的旧信号不执行
Z_EXECUTION_MAX_SIGNAL_AGE_MS=3000

# 少于 20 秒不执行
Z_EXECUTION_MIN_REMAINING_SECONDS=20

# ask 高于 0.95 不买
Z_EXECUTION_MAX_ASK=0.95

# 挂单超过 2 秒未成交则撤
Z_EXECUTION_ORDER_TIMEOUT_MS=2000

# 每 500ms 检查一次新信号
Z_EXECUTION_TAIL_INTERVAL_MS=500
