
RPC_URL=https://rpc.ankr.com/bsc,https://bsc-dataseed.binance.org,https://bsc-dataseed1.binance.org


#chrome0 测试3 对应的predict 导出的sy
PRIVY_PRIVATE_KEY=xxx
#导出的地址
#PREDICT_ACCOUNT=xxx
#predict.fun deposit的地址
PREDICT_ACCOUNT=xxxx

PREDICT_API_KEY=xxxx

# FICLASH 本地代理地址；赛中 Dota 脚本的所有 HTTP 请求都走该代理
FICLASH_PROXY_URL=http://127.0.0.1:7890

# 上证指数做市：北京时间允许挂 BUY 的时段；默认避开凌晨 00:00-08:00。
# 多个时段用逗号分隔，例如 08:00-12:00,13:00-24:00
SSE_QUOTE_WINDOWS=08:00-24:00

# 赛中 Dota 脚本轮询间隔
DOTA2_INGAME_INTERVAL_MS=3000
# 每个方向单次挂买数量；默认101，若改为100请同时把下面的撤单阈值改为100
DOTA2_INGAME_ORDER_SHARES=101
# 某方向持仓达到该数量后停止该方向买入
DOTA2_INGAME_POSITION_LIMIT_SHARES=100
# 买单剩余量低于该数量时撤单并通知挂买流程重新判断
DOTA2_INGAME_MIN_BUY_ORDER_SHARES=101
# 两个独立监控子流程的轮询间隔
DOTA2_INGAME_POSITION_INTERVAL_MS=2000
DOTA2_INGAME_BUY_MONITOR_INTERVAL_MS=1000
# 定时只撤买单，撤完唤醒挂买流程；默认11分钟
DOTA2_INGAME_BUY_CANCEL_INTERVAL_MS=660000

# 每分钟查询
MIN_INTERVAL_SECONDS=60
# 无新增时每5分钟推送一次
NORMAL_PUSH_INTERVAL_SECONDS=300
#DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=1111
DING_ACCESS_TOKEN=111
DING_SECRET=1111

# token缓存失效时间
JWT_CACHE_TTL_SECONDS

# 先保持纸面模式
Z_LIVE_TRADING=false

# BTC 5m 采样和双波动率概率模型。Chainlink startPrice 来自 Predict；盘中参考价使用 Binance Top-of-Book。
BTC_SAMPLE_INTERVAL_MS=2000
Z_FAST_VOLATILITY_WINDOW_SECONDS=30
Z_SLOW_VOLATILITY_WINDOW_SECONDS=180
Z_VOLATILITY_UNCERTAINTY=1.15
Z_MICROPRICE_WEIGHT=0.5
Z_ENTRY_THRESHOLD=0.5
Z_EDGE_MARGIN=0.005
Z_MIN_ENTRY_PROBABILITY=0.70
Z_MAX_SPREAD=0.02
Z_TRADE_NOTIONAL_USD=10
Z_MAX_REFERENCE_AGE_MS=5000

# 首次真实验证时建议 1 USDT
Z_EXECUTION_NOTIONAL_USD=5

# 超过 3 秒的旧信号不执行
Z_EXECUTION_MAX_SIGNAL_AGE_MS=3000

# 仅保留签名和网络提交缓冲，不作为模型风控
Z_EXECUTION_MIN_REMAINING_SECONDS=2

# ask 高于 0.95 不买
Z_EXECUTION_MAX_ASK=0.95

# 挂单超过 2 秒未成交则撤
Z_EXECUTION_ORDER_TIMEOUT_MS=2000

# 每 500ms 检查一次新信号
Z_EXECUTION_TAIL_INTERVAL_MS=500

# 当前持仓模型价值比立即卖出价值低 2 个百分点时退出，避免概率边界抖动
Z_EXIT_EDGE_MARGIN=0.20
Z_POSITION_REFRESH_MS=1000
Z_MIN_ORDER_EXPIRY_MS=125000

# 本地只读可视化页面
BTC_DASHBOARD_HOST=127.0.0.1
BTC_DASHBOARD_PORT=3210

# 独立 BTC 5m 反转价值纸面策略；不读取钱包，也不会真实下单
RV_FIXED_SHARES=20
RV_MAX_PRICE=0.70
RV_MIN_PRICE=0.05
RV_MIN_EDGE=0.03
RV_MIN_PROBABILITY=0.30
RV_MAX_SPREAD=0.03
RV_MIN_REVERSAL_BPS=0.5
RV_MIN_REMAINING_SECONDS=20
RV_MAX_REMAINING_SECONDS=240
RV_FAST_VOLATILITY_WINDOW_SECONDS=30
RV_SLOW_VOLATILITY_WINDOW_SECONDS=180
RV_MIN_HISTORY_SECONDS=45
RV_MIN_HISTORY_OBSERVATIONS=15
RV_VOLATILITY_FLOOR_BPS=0.5
RV_VOLATILITY_UNCERTAINTY=1.2
RV_MEAN_REVERSION_HALF_LIFE_SECONDS=120
RV_MOMENTUM_HORIZON_SECONDS=45
RV_MICROPRICE_WEIGHT=0.5
RV_SKIP_WEEKENDS=true

# Arcus 现货机器人：仅私钥和可选 API Key 属于敏感配置。
# 默认观察模式不需要私钥；只有 node src/arcus/tradeBot.js --live 才会读取私钥并真实下单。
ARCUS_PRIVATE_KEY=0xYOUR_ROBINHOOD_MAINNET_PRIVATE_KEY
# 公共路由目前通常可不填；若 Arcus 为你的集成分配了 Key 再填写。
ARCUS_API_KEY=
